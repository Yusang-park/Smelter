{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__pencil",
      "mcp__serena",
      "Read",
      "Glob",
      "Grep",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(pnpm:*)",
      "Edit",
      "Write"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "node /Users/yusang/smelter/vendor/claude-dashboard/dist/index.js"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "_comment": "Smelter runs directly from this ~/.claude-linked repo. Plugin marketplace wiring and duplicate hook registration were removed to avoid double execution and prompt inflation."
}
