{
  "mode": "simple_fix",
  "description": "Text, CSS, constants—explicit value substitution only.",
  "entry_skill": "workflow-coding",
  "allowed_skills": [
    "workflow-coding",
    "workflow-e2e",
    "workflow-human-check"
  ],
  "default_team_overrides": {
    "workflow-coding": { "pattern": "A", "default_agent": "executor" },
    "workflow-e2e":    { "pattern": "A", "default_agent": "qa-tester" }
  },
  "default_exempt": { "tdd": true, "e2e": false },
  "magic_keywords": {
    "css":       { "set": { "exempt.tdd": true,  "exempt.e2e": false } },
    "style":     { "set": { "exempt.tdd": true,  "exempt.e2e": false } },
    "i18n":      { "set": { "exempt.tdd": true,  "exempt.e2e": false } },
    "typo":      { "set": { "exempt.tdd": true,  "exempt.e2e": true  } },
    "dialogue":  { "set": { "exempt.tdd": true,  "exempt.e2e": true  } }
  },
  "transitions": {
    "upgrade_to":   ["fix", "implement", "plan"],
    "downgrade_to": []
  }
}
