{
  "mode": "implement",
  "description": "Lightweight implementation based on existing code. Start with brainstorm-light.",
  "entry_skill": "workflow-brainstorm",
  "entry_params": { "workflow-brainstorm": { "depth": "light" } },
  "allowed_skills": [
    "workflow-brainstorm", "workflow-brainstorm-review",
    "workflow-investigate", "workflow-investigate-review",
    "workflow-tasker", "workflow-tasker-review",
    "workflow-write-test", "workflow-coding",
    "workflow-agent-review",
    "workflow-e2e", "workflow-e2e-review",
    "workflow-team-code-review", "workflow-human-check"
  ],
  "default_team_overrides": {
    "workflow-brainstorm":         { "pattern": "A", "default_agent": "planner" },
    "workflow-brainstorm-review":  { "pattern": "B", "default_agent": "critic" },
    "workflow-investigate":        { "pattern": "C", "default_agent": "explore-medium", "aggregator": "architect" },
    "workflow-investigate-review": { "pattern": "A", "default_agent": "explore-high" },
    "workflow-tasker":             { "pattern": "D", "lead": "architect", "sub_agents": ["executor"] },
    "workflow-tasker-review":      { "pattern": "B", "default_agents": ["advocate", "critic", "arbitrator"] },
    "workflow-write-test":         { "pattern": "C", "default_agent": "executor", "aggregator": "executor" },
    "workflow-coding":             { "pattern": "C", "default_agent": "executor", "watchdog_enabled": true, "aggregator": "architect" },
    "workflow-agent-review":       { "pattern": "B", "default_agents": ["code-reviewer", "security-reviewer"], "aggregator": "arbitrator" },
    "workflow-e2e":                { "pattern": "A", "default_agent": "qa-tester" },
    "workflow-e2e-review":         { "pattern": "A", "default_agent": "code-reviewer" },
    "workflow-team-code-review":   { "pattern": "B", "default_agents": ["advocate", "critic", "arbitrator"], "aggregator": "arbitrator" }
  },
  "default_exempt": { "tdd": false, "e2e": false },
  "magic_keywords": {
    "extend":    { "set": { "skip_brainstorm": true } },
    "add to":    { "set": { "skip_brainstorm": true } },
    "덧붙여":     { "set": { "skip_brainstorm": true } },
    "css":       { "set": { "exempt.tdd": true,  "exempt.e2e": false } },
    "style":     { "set": { "exempt.tdd": true,  "exempt.e2e": false } },
    "i18n":      { "set": { "exempt.tdd": true,  "exempt.e2e": false } }
  },
  "transitions": {
    "upgrade_to":   ["plan"],
    "downgrade_to": ["fix", "simple_fix"]
  }
}
