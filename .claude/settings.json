{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__pencil",
      "mcp__semble",
      "Read",
      "Glob",
      "Grep",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(pnpm:*)",
      "Edit",
      "Write"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {},
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "_comment": "Smelter hooks and statusLine are registered globally in ~/.claude/settings.json to avoid duplicate project-local hook execution.",
  "model": "gpt-5.4"
}
